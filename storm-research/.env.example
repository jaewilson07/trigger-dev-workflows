# Trigger.dev project credentials
TRIGGER_API_URL=https://triggers.datacrew.space
TRIGGER_PROJECT_REF=
TRIGGER_SECRET_KEY=

# Letta Cloud — the LLM/agent backend for STORM perspectives.
# Same key as executive-assistant, synced from Infisical /letta at deploy time.
# STORM uses two existing agents from the DataCrew fleet:
#   EmmaBot (agent-5afcfa48-...) for deep research perspectives
#   IdrisBot (agent-0604eb6c-...) as the skeptic perspective
# No new agents need to be created.
LETTA_API_KEY=
LETTA_BASE_URL=https://api.letta.com
LETTA_MODEL=letta/auto-fast

# Slack delivery (post briefing to DM)
DATACREW_SLACK_BOT_TOKEN=
STORM_SLACK_CHANNEL=user:U08L4B485B4

# Infisical machine identity (for syncEnvVars at deploy time)
# Same values as executive-assistant — see its .env.example for full docs.
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_API_URL=https://infisical.datacrew.space
INFISICAL_PROJECT_ID=3fbb4296-d4e6-4c17-83ee-b852a57a5e50
INFISICAL_SECRET_PATH=/
