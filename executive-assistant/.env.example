# Trigger.dev project credentials
TRIGGER_API_URL=https://triggers.datacrew.space
TRIGGER_PROJECT_REF=
TRIGGER_SECRET_KEY=

# Morning brief target user/channel
MORNING_BRIEF_USER_ID=U08L4B485B4
MORNING_BRIEF_SLACK_CHANNEL=
BRIEF_ACTIVITY_LOG_PATH=../data/brief-activity.jsonl

# Google Workspace auth (Gmail via googleapis, no cboti/Python dependency --
# fetch-emails.ts + lib/google-auth.ts read the stored token straight from
# auth-service and refresh it directly). GDOC_CLIENT is NOT used by this
# path -- client_id/client_secret are read from the STORED token itself
# (verified against a real one: it already carries them, no expiry field).
AUTH_SERVICE_URL=https://api.datacrew.space
GOOGLE_TOKEN_API_KEY=
GDOC_CLIENT=

# mdrag — shared by two DIFFERENT integrations against the same instance:
#   1. MCP topic search (tasks/search-topics.ts -> lib/mdrag-topic-search.ts, hits /mcp/)
#   2. /api/v1/primitives REST router (research-primitives-demo.ts, datacrew#298, hits /api/v1/primitives/*)
# Same dc_ JWT works for both — mdrag's ApiKeyMiddleware gates every /mcp and
# /api/v1/* route behind the same token, no route-specific scope required for
# /api/v1/primitives/*. Sent as X-DC-Token (not Authorization: Bearer) because
# wiki.datacrew.space sits behind Cloudflare Access, which strips Authorization.
MDRAG_URL=https://wiki.datacrew.space
MDRAG_TOKEN=

# Pattern Hunter (datacrew#302) — its own FastAPI service (projects/pattern-hunter/main.py),
# NOT mdrag directly (Pattern Hunter calls mdrag internally for Nodes 2/3/5).
# No auth token: confirmed by reading main.py — no auth middleware/Depends on
# any route.
#
# NOW DEPLOYED (homeserver/apps/pattern-hunter/, container `pattern-hunter`,
# same ai-network as trigger-webapp-1 — verified via `docker network
# inspect ai-network`). Real Trigger.dev task deployments (whatever actually
# runs the tasks, reached via the self-hosted triggers.datacrew.space
# instance) should set PATTERN_HUNTER_URL=http://pattern-hunter:8090 (the
# container DNS name on ai-network), NOT localhost. The localhost:8090
# default below is for local dev only (running Pattern Hunter directly on
# your own machine via `uvicorn main:app --port 8090`, per
# projects/pattern-hunter/AGENTS.md's "Running locally" section).
PATTERN_HUNTER_URL=http://localhost:8090

# Pattern Hunter's POST /publish/gdoc ONLY (datacrew#338, "save report to my
# own Google Drive"). Every other Pattern Hunter route above has no auth (see
# PATTERN_HUNTER_URL's own comment); this ONE route requires this shared
# secret as header X-Publish-API-Key, because — given just a user_id string —
# it writes into a real person's Google Drive using their real stored OAuth
# credential. MUST match PATTERN_HUNTER_PUBLISH_API_KEY set on the Pattern
# Hunter container itself (projects/pattern-hunter/main.py /
# homeserver/apps/pattern-hunter/docker-compose.yml — the latter needs this
# var added at deploy time, a homeserver-repo change not included in this PR).
# Used by tasks/pattern-hunter-publish-gdoc.ts.
PATTERN_HUNTER_PUBLISH_API_KEY=

# Gateway LLM (email triage + synthesis). Container DNS on ai-network for
# deployed tasks (the runner is an isolated container -- localhost:7630 as
# this pointed at before resolves to the runner itself, not the gateway, the
# same class of bug PATTERN_HUNTER_URL below already documents). Override to
# http://localhost:7630/v1/chat/completions only for local `trigger dev`.
GATEWAY_URL=http://gateway:7630/v1/chat/completions

# Slack delivery
DATACREW_SLACK_BOT_TOKEN=
