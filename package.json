{
  "name": "trigger-dev-workflows",
  "private": true,
  "type": "module",
  "workspaces": [
    "watchdog",
    "executive-assistant",
    "packages/shared"
  ],
  "scripts": {
    "dev:watchdog": "npm --prefix watchdog run dev",
    "deploy:watchdog": "npm run preflight && npm --prefix watchdog run deploy",
    "dev:executive-assistant": "npm --prefix executive-assistant run dev",
    "deploy:executive-assistant": "npm run preflight && npm --prefix executive-assistant run deploy",
    "check:trigger-logging": "node scripts/check-trigger-logging.mjs",
    "check:trigger-logging:all": "node scripts/check-trigger-logging.mjs --all",
    "check:trigger-logging:staged": "node scripts/check-trigger-logging.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "preflight": "node scripts/preflight-deploy.mjs",
    "deadman": "node scripts/trigger-deadman.mjs"
  }
}
