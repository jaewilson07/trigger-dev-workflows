# Node modules and build outputs
node_modules/
**/node_modules/
dist/
**/dist/

# Trigger local cache/artifacts
.trigger/
**/.trigger/

# Environment files
.env
.env.*
!.env.example

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS/editor artifacts
.DS_Store
.vscode/
.idea/

# Ephemeral per-agent worktree bookkeeping. `.claude/` itself is tracked here
# (skills are committed), so ignore just this file rather than the directory.
.claude/.worktree-sessions.json
**/.claude/.worktree-sessions.json

# Claude Code runtime artifacts — agent worktrees are local scratch,
# never shared. Targeted rather than a blanket .claude/ ignore because this
# repo tracks committed files under .claude/ (skills, agents, settings).
.claude/worktrees/
