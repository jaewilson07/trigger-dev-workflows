# Trigger.dev project credentials
TRIGGER_API_URL=https://triggers.datacrew.space
TRIGGER_PROJECT_REF=
TRIGGER_SECRET_KEY=

# No SYNCED_SECRETS in trigger.config.ts yet — the indb-blues-hello task
# (trigger-dev-workflows#97) needs no external credentials. When a later
# task in this project (#98-#101) needs a real secret, add it to Infisical
# under /trigger as INDB_BLUES_<NAME> and wire it the same way
# executive-assistant's trigger.config.ts does (SYNCED_SECRETS + syncEnvVars),
# or set it directly on the trigger.dev dashboard environment if it's
# run-time-only (see watchdog, which has no syncEnvVars extension at all —
# every one of its secrets is set on the dashboard instead).
