# Trigger.dev project credentials
TRIGGER_API_URL=https://triggers.datacrew.space
TRIGGER_PROJECT_REF=
TRIGGER_SECRET_KEY=

# No SYNCED_SECRETS in trigger.config.ts — every secret the blues-drop tasks
# need (trigger-dev-workflows#98) is fetched at RUNTIME via getSecret(),
# same as watchdog's crewRagDomoScrape.ts, so nothing needs to be baked into
# the deploy. INFISICAL_CLIENT_ID/INFISICAL_CLIENT_SECRET below are what
# getSecret() itself authenticates with — set on the trigger.dev dashboard
# environment, not synced.
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_API_URL=https://infisical.datacrew.space

# Fetched at runtime by blues-drop-research/deliver-discord — listed here
# for reference only, not read directly from process.env (getSecret() pulls
# them from Infisical, homeserver project 3fbb4296-d4e6-4c17-83ee-b852a57a5e50):
#   JAEWILSON07_GH_PAT       — clones indb_discordbot + cboti (both private)
#   SPOTIFY_CLIENT_ID        — Spotify matching (curate-bma-nominees)
#   SPOTIFY_CLIENT_SECRET
#   BLUES_DISCORD_BOT_TOKEN  — tried first; falls back to IMDB_DISCORD_BOT_TOKEN,
#                              the actual (evidently misnamed) secret found live
#                              in Infisical — see deliver-discord.ts's comment.
#   DATACREW_API_TOKEN       — mdrag token-mode credential for
#                              research-coverage (trigger-dev-workflows#100,
#                              lib/blues-drop-coverage.ts). Absent is a normal
#                              "coverage skipped" state, not a hard failure —
#                              getOptionalSecret() in bluesDropResearch.ts.
#   YOUTUBE_API_KEY          — NOT YET IN INFISICAL. research-youtube
#                              (lib/blues-drop-youtube.ts) reads this name;
#                              its absence is the current, live state and is
#                              a normal "video skipped" outcome, not a hard
#                              failure. `GOOGLE_TOKEN_API_KEY` was checked
#                              live (2026-08-19) as a candidate and confirmed
#                              NOT usable — it's a different-purpose
#                              auth-service credential, not a Google Cloud API
#                              key (see blues-drop-youtube.ts's module
#                              docstring for the live-verified detail).
#                              MANUAL FOLLOW-UP to actually enable video
#                              research: Google Cloud Console → enable
#                              "YouTube Data API v3" → Credentials → create an
#                              API key → store it in Infisical (homeserver
#                              project, root path) as YOUTUBE_API_KEY. No code
#                              change needed once that secret exists.

# mdrag base URL for research-coverage's TOKEN-mode call
# (lib/blues-drop-coverage.ts). Optional — defaults to the public
# https://wiki.datacrew.space when unset, which is safe ONLY because this
# call always uses the TOKEN credential (see that module's docstring for why
# a VOUCH call must never be aimed at that host). Override to
# http://mdrag-local:8017 if this project ever runs somewhere with a route to
# bonker's internal network.
MDRAG_URL=

# Notion delivery (trigger-dev-workflows#99). NOT fetched via getSecret() —
# @datacrew/trigger-shared's notionTokenFromEnv() reads these two directly
# from process.env, same as every other deliver-notion in this repo
# (docs/notion-delivery.md §5). Set on the indb-blues trigger.dev environment
# directly — this project has no `syncEnvVars` extension at all
# (trigger.config.ts), so nothing here is picked up from Infisical
# automatically; NOTION_DATABASE_ID in particular must NOT be added to a
# SYNCED_SECRETS allowlist that doesn't exist for this project.
NOTION_TOKEN=
# NOTION_API_KEY=            # fallback name; the org's actual Infisical secret
NOTION_DATABASE_ID=
